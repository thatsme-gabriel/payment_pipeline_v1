# Copie para .env e preencha localmente. Este modelo deve permanecer sem credenciais.
# Credencial de gerenciamento do Confluent: usada apenas em setup, evidencias e teardown.
CONFLUENT_CLOUD_API_KEY=
CONFLUENT_CLOUD_API_SECRET=
# UUID da organizacao (Settings > Organization).
CONFLUENT_ORGANIZATION_ID=

# Banco EXCLUSIVO para o desafio; endpoint direto, sem -pooler.
# Habilite logical replication no painel do Neon antes do setup.
# Copie a URL do proprietario no painel Neon, com sslmode=require e endpoint direto.
DATABASE_URL=
CDC_PASSWORD=
DATABASE_SSLMODE=require

# Opcionais: chaves Cloud de uma SA com MetricsViewer e acesso a billing.
# Se vazias, a coleta usa a chave de gerenciamento acima.
METRICS_API_KEY=
METRICS_API_SECRET=
BILLING_START_DATE=
BILLING_END_DATE=

# Ajustes locais. Nao e preciso uma conta AWS.
PYTHON=
TERRAFORM=terraform
CONSUMER_GROUP=desafio-alerts
SEED=42
TIMEOUT_SECONDS=900
